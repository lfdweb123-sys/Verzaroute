rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    match /influencers/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      match /private/{doc} { allow read, write: if false; }
    }
    match /brands/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      match /private/{doc} { allow read, write: if false; }
    }
    match /campaigns/{cid} {
      allow read: if true;
      allow create: if false;
      allow update: if isAuth() && (resource.data.influencer_id == request.auth.uid || resource.data.brand_id == request.auth.uid);
    }
    match /campaign_redemptions/{rid} {
      allow read: if isAuth() && (resource.data.influencer_id == request.auth.uid || resource.data.brand_id == request.auth.uid);
      allow create: if false;
      allow update: if false;
    }
    match /wallet_transactions/{tid} {
      allow read: if isAuth() && (resource.data.influencer_id == request.auth.uid || resource.data.brand_id == request.auth.uid);
      allow create: if false;
      allow update: if false;
    }
    match /deposit_payments/{pid} {
      allow read: if isAuth() && (resource.data.influencer_id == request.auth.uid || resource.data.brand_id == request.auth.uid);
      allow create: if false;
      allow update: if false;
    }
    match /email_campaigns/{eid} {
      allow read: if isAuth() && resource.data.owner_id == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /ai_usage/{uid} {
      allow read: if isAuth() && resource.data.owner_id == request.auth.uid;
      allow write: if false;
    }
    match /email_templates/{tid} {
      allow read: if isAuth() && resource.data.owner_id == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /admin_config/{doc} { allow read, write: if false; }
    match /contact_lists/{lid} {
      allow read: if isAuth() && resource.data.owner_id == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
    match /email_send_usage/{uid} {
      allow read: if isAuth() && resource.data.owner_id == request.auth.uid;
      allow write: if false;
    }
    match /artist_profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /dedication_orders/{oid} {
      allow read: if isAuth() && (resource.data.artistUid == request.auth.uid || resource.data.fanUid == request.auth.uid);
      allow write: if false;
    }
    match /ai_song_orders/{sid} {
      allow read: if isAuth() && resource.data.fanUid == request.auth.uid;
      allow write: if false;
    }
    match /email_otps/{email} {
      allow read, write: if false;
    }
  }
}